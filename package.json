{
  "name": "planit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "esbuild test/run.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/planit-test.mjs --log-level=error && node node_modules/.cache/planit-test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "serve": "npm run build && vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lz-string": "^1.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}